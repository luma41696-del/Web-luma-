# Normalise line endings so the repo stays consistent regardless of which OS
# a contributor is on. Text files are stored with LF in git and checked out
# with the platform's native endings.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ttf binary
*.woff2 binary
*.ico binary
